FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

OPENAI_API_KEY=sk-...

NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=your-notion-database-id

# Number of Kijiji search result pages to scrape per run (default: 15)
MAX_PAGES_PER_RUN=15

# Total minutes to spread page fetches across (default: 120).
# Page delay = SCRAPE_WINDOW_MINUTES / MAX_PAGES_PER_RUN, with ±25% jitter.
# Example: 15 pages over 120 min → ~8 min between pages (range: 6–10 min).
SCRAPE_WINDOW_MINUTES=120
