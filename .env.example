FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

OPENAI_API_KEY=sk-...

NOTION_API_KEY=secret_...   # or ntn_... for modern Notion integration tokens
NOTION_DATABASE_ID=your-notion-database-id
# Set to true to enable Notion duplicate checks and lead writes (default: false).
# When false, NOTION_API_KEY and NOTION_DATABASE_ID are not required.
NOTION_ENABLED=false
# Notion database property name that stores phone numbers (default: "Phone").
# Must be a Phone Number type property. Used for duplicate detection and lead writes.
# Phone numbers must be stored in E.164 format (+1XXXXXXXXXX) for dedup to work reliably.
NOTION_PHONE_PROPERTY=Phone

# Number of Kijiji search result pages to scrape per run (default: 15)
MAX_PAGES_PER_RUN=15

# Total minutes to spread page fetches across (default: 120).
# Page delay = SCRAPE_WINDOW_MINUTES / MAX_PAGES_PER_RUN, with ±25% jitter.
# Example: 15 pages over 120 min → ~8 min between pages (range: 6–10 min).
SCRAPE_WINDOW_MINUTES=120

# Random delay between listing detail page visits (default: 10–30 s).
DETAIL_DELAY_MIN_SECONDS=10
DETAIL_DELAY_MAX_SECONDS=30

# Optional cap on detail page visits per production run (default: unlimited).
# Useful when MAX_PAGES_PER_RUN=1 can yield ~46 listings but you only want to process a few.
# Has no effect in TEST_MODE (use TEST_MAX_LISTINGS instead).
# LIVE_MAX_LISTINGS_PER_RUN=10

# ── Test mode ─────────────────────────────────────────────────────────────────
# Set TEST_MODE=true to run a quick local scrape without needing real credentials.
# Credentials (Firebase, Notion, OpenAI) are NOT required when TEST_MODE=true.
# All Firestore/Notion reads and writes are skipped unless TEST_WRITE_TO_FIRESTORE=true.
# Verbose [TEST] log lines show extracted data, skip reasons, phone metadata, and messages.
TEST_MODE=false
TEST_MAX_PAGES=1
TEST_MAX_LISTINGS=3
TEST_WRITE_TO_FIRESTORE=false

# Set FAST_TEST_MODE=true to use 1–3 s detail delays instead of the full range.
# Only takes effect alongside TEST_MODE=true for rapid local iteration.
FAST_TEST_MODE=false

# ── Startup behavior ──────────────────────────────────────────────────────────
# RUN_IMMEDIATELY=true runs the pipeline once on startup, then keeps the
# daily cron scheduler running. Useful for development and VPS first-boot.
# Default false (scheduled-only).
RUN_IMMEDIATELY=false
